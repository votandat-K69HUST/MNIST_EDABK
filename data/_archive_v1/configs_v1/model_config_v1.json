{
  "name": "mlp_v1",
  "seed": 0,
  "num_threads": 8,
  "data": {
    "train": [
      {
        "path": "../data/output/m03_qmnist_same_writer/train.npz",
        "weight": 0.35
      },
      {
        "path": "../data/output/m04_ligature_strokes/train.npz",
        "weight": 0.3
      },
      {
        "path": "../data/output/m02_mnist_style_matched/train.npz",
        "weight": 0.2
      },
      {
        "path": "../data/output/m01_mnist_random_concat/train.npz",
        "weight": 0.15
      },
      {
        "path": "../data/output/self_numbers_train.npz",
        "weight": 0.0
      }
    ],
    "total_train": 120000,
    "val": {
      "synthetic": [
        "../data/output/m04_ligature_strokes/val.npz",
        "../data/output/m03_qmnist_same_writer/val.npz"
      ],
      "real": [
        "../data/output/self_numbers_val.npz"
      ]
    }
  },
  "augment": {
    "enabled": true,
    "rotate": 8,
    "scale": [
      0.9,
      1.1
    ],
    "aspect_jitter": [
      0.93,
      1.07
    ],
    "shear": 10,
    "shift": 2,
    "thickness_p": 0.3,
    "thickness_strength": [
      0.3,
      0.8
    ],
    "gamma_p": 0.3,
    "gamma": [
      0.8,
      1.25
    ],
    "noise_std": 0.03
  },
  "model": {
    "hidden": [
      512,
      256
    ],
    "dropout": 0.2,
    "activation": "relu",
    "batchnorm": true,
    "input_dropout": 0.0
  },
  "train": {
    "epochs": 20,
    "batch_size": 256,
    "optimizer": "adamw",
    "lr": 0.002,
    "weight_decay": 0.0001,
    "scheduler": "cosine",
    "warmup_epochs": 1,
    "min_lr_frac": 0.01,
    "label_smoothing": 0.05,
    "grad_clip": 1.0,
    "patience": 6
  },
  "ensemble": {
    "seeds": [
      0,
      1,
      2
    ]
  },
  "predict": {
    "test_csv": "../test.csv",
    "output": "../output.csv",
    "tta_shifts": 0
  }
}